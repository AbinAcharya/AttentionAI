<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app learns is eligible for cloud backup or device transfer. The profile
  file is derived from the user's private message traffic; it belongs on one device and
  nowhere else. allowBackup=false covers the legacy path; this file covers Android 12+
  backup and device-to-device transfer explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
